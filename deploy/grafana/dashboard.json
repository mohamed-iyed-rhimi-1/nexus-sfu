{
  "dashboard": {
    "title": "Nexus SFU Metrics",
    "tags": [
      "nexus",
      "sfu",
      "webrtc"
    ],
    "timezone": "browser",
    "description": "Data plane (nexus_shard_*, per shard). The nexus_sfu_* and nexus_crdt_* series are still exported but nothing feeds them since Phase 1 (they read zero), so no panel shows them.",
    "panels": [
      {
        "id": 1,
        "title": "Shard Datagrams",
        "type": "graph",
        "targets": [
          {
            "expr": "rate(nexus_shard_rx_datagrams_total[1m])",
            "legendFormat": "rx shard {{shard}}"
          },
          {
            "expr": "rate(nexus_shard_tx_datagrams_total[1m])",
            "legendFormat": "tx shard {{shard}}"
          }
        ],
        "yaxes": [
          {
            "label": "datagrams/sec",
            "format": "short"
          }
        ]
      },
      {
        "id": 2,
        "title": "Shard Bandwidth",
        "type": "graph",
        "targets": [
          {
            "expr": "rate(nexus_shard_rx_bytes_total[1m]) * 8",
            "legendFormat": "rx shard {{shard}}"
          },
          {
            "expr": "rate(nexus_shard_tx_bytes_total[1m]) * 8",
            "legendFormat": "tx shard {{shard}}"
          }
        ],
        "yaxes": [
          {
            "label": "bits/sec",
            "format": "bps"
          }
        ]
      },
      {
        "id": 3,
        "title": "Shard Drops",
        "type": "graph",
        "targets": [
          {
            "expr": "rate({__name__=~\"nexus_shard_drop_.*_total\"}[1m]) > 0",
            "legendFormat": "{{__name__}} shard {{shard}}"
          }
        ],
        "yaxes": [
          {
            "label": "datagrams/sec",
            "format": "short"
          }
        ]
      },
      {
        "id": 4,
        "title": "Sessions, Tracks, Subscriptions",
        "type": "graph",
        "targets": [
          {
            "expr": "nexus_shard_sessions",
            "legendFormat": "sessions shard {{shard}}"
          },
          {
            "expr": "nexus_shard_tracks",
            "legendFormat": "tracks shard {{shard}}"
          },
          {
            "expr": "nexus_shard_subscriptions",
            "legendFormat": "subscriptions shard {{shard}}"
          }
        ],
        "yaxes": [
          {
            "label": "count",
            "format": "short"
          }
        ]
      },
      {
        "id": 5,
        "title": "RTCP: Sender Reports and Keyframe Requests",
        "type": "graph",
        "targets": [
          {
            "expr": "rate(nexus_shard_sr_translated_total[1m])",
            "legendFormat": "SRs translated shard {{shard}}"
          },
          {
            "expr": "rate(nexus_shard_keyframe_requests_total[1m])",
            "legendFormat": "PLIs to publishers shard {{shard}}"
          },
          {
            "expr": "rate(nexus_shard_keyframe_throttled_total[1m])",
            "legendFormat": "PLIs throttled shard {{shard}}"
          }
        ],
        "yaxes": [
          {
            "label": "packets/sec",
            "format": "short"
          }
        ]
      },
      {
        "id": 6,
        "title": "ICE: Address Selection and Consent",
        "type": "graph",
        "targets": [
          {
            "expr": "increase(nexus_shard_nominations_total[5m])",
            "legendFormat": "nominations shard {{shard}}"
          },
          {
            "expr": "increase(nexus_shard_rebinds_total[5m])",
            "legendFormat": "rebinds shard {{shard}}"
          },
          {
            "expr": "increase(nexus_shard_consent_lost_total[5m])",
            "legendFormat": "consent lost shard {{shard}}"
          }
        ],
        "yaxes": [
          {
            "label": "per 5 min",
            "format": "short"
          }
        ]
      }
    ]
  }
}
